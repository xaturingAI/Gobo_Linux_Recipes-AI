#!/bin/bash

# FastFetch 2.68.1 for GoboLinux, packaged from the official prebuilt Linux
# tarball. The binary is fully self-contained (links only libm/libc), so no
# toolchain or runtime deps beyond the ISO base. Ships fastfetch + flashfetch,
# bash/zsh/fish completions, a man page and the full preset collection
# (all.jsonc, neofetch/screenfetch/archey/paleofetch emulations, ci, examples).

compile_version=017-GIT
url="https://github.com/fastfetch-cli/fastfetch/releases/download/2.68.1/fastfetch-linux-amd64.tar.gz"
file_size=7078976
file_md5=dfee7824f493347a155a3c59a75f53b3
recipe_type=manifest
uncompress=no

symlink_options=(
    "--conflict=overwrite"
)

manifest=(
    "fastfetch-linux-amd64/usr/bin/fastfetch:bin/fastfetch"
    "fastfetch-linux-amd64/usr/bin/flashfetch:bin/flashfetch"
    "fastfetch-linux-amd64/usr/share/bash-completion/completions/fastfetch:share/bash-completion/completions/fastfetch"
    "fastfetch-linux-amd64/usr/share/zsh/site-functions/_fastfetch:share/zsh/site-functions/_fastfetch"
    "fastfetch-linux-amd64/usr/share/fish/vendor_completions.d/fastfetch.fish:share/fish/vendor_completions.d/fastfetch.fish"
    "fastfetch-linux-amd64/usr/share/man/man1/fastfetch.1:share/man/man1/fastfetch.1"
    "fastfetch-linux-amd64/usr/share/fastfetch:share/fastfetch"
    "fastfetch-linux-amd64/usr/share/licenses/fastfetch:share/licenses/fastfetch"
)

pre_install() {
    local tarball="$compileArchivesDir/$(basename $url)"
    Log_Normal "Unpacking ${tarball}"
    tar xzf "$tarball"
}