# CMake 3.30.4 for the Live CD.
#
# The reference ISO ships CMake 3.16.4, too old for the Vulkan SDK 1.4.357.0
# stack (needs >= 3.22.1). Built from source with bundled third-party libraries
# (no --system-libs) so it builds self-contained on the 2020-era chroot.
compile_version=2.0
url="https://cmake.org/files/v3.30/cmake-3.30.4.tar.gz"
file_size=11502808
file_md5=763e728f837b82d151f9a7b0eb290d94
recipe_type=configure
configure=bootstrap

do_configuration() {
  ./bootstrap \
    --prefix=$target \
    --parallel=$(getconf _NPROCESSORS_ONLN) \
    --docdir=$target/doc/cmake-3.30.4 \
    --no-system-jsoncpp \
    --no-system-cppdap \
    --no-system-librhash \
    --no-system-libarchive \
    --no-system-bzip2 \
    --no-system-curl \
    -- -DCMake_TEST_Qt5=OFF
}

pre_install() {
    if [ ! -z "$goboIndex" -a -d "$goboIndex" ]
    then
        GrepReplace "$goboIndex" "$target" cmake_install.cmake
    fi
}
