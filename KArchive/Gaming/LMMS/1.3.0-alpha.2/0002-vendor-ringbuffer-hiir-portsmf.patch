+++ b/src/3rdparty/ringbuffer/include/ringbuffer/ringbuffer.h	2022-02-24 13:40:01.000000000 -0500
@@ -0,0 +1,427 @@
+/*************************************************************************/
+/* ringbuffer - a multi-reader, lock-free ringbuffer lib                 */
+/* Copyright (C) 2014-2020                                               */
+/* Johannes Lorenz (j.git@lorenz-ho.me, $$$=@)                           */
