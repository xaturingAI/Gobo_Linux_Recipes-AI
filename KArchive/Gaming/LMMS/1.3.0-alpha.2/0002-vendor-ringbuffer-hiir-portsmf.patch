+
+
+
+/*\\\ PRIVATE \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\*/
+
+
+
+template <int NC, typename DT, int NCHN>
+constexpr int	PhaseHalfPiTpl <NC, DT, NCHN>::_nbr_phases;
+
+
