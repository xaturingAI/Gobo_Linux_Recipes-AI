+    Alg_time_sig_ptr time_sigs;
+public:
+    Alg_time_sigs() {
+        maxlen = len = 0;
+        time_sigs = nullptr;
+    }
+    Alg_time_sig &operator[](int i) { //!< fetch a time signature
+        assert(i >= 0 && i < len);
+        return time_sigs[i];
+    }
+    ~Alg_time_sigs() { delete[] time_sigs; }
+    void show();
+    long length() { return len; }
