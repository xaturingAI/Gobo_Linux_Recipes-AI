+}
+
+
+
+/*
+==============================================================================
+Name: process_sample
+Description:
+	From one 2-channel input vector, generates two vectors with a pi/2 phase
+	shift between these signals.
+Input parameters:
+	- input: The input sample.
+Output parameters:
+	- out_0: Output sample, ahead.
+	- out_1: Output sample, late.
+Throws: Nothing
+==============================================================================
+*/
+
+template <int NC>
+void	PhaseHalfPi2F64Sse2 <NC>::process_sample (__m128d &out_0, __m128d &out_1, __m128d input) noexcept
+{
+	out_0 = input;                // Even coefs
+	out_1 = _mm_load_pd (_prev);  // Odd coefs
+
+	StageProc2F64Sse2 <NBR_COEFS>::process_sample_neg (
+		NBR_COEFS, out_0, out_1, &_bifilter [_phase] [0]
+	);
+
+	_mm_store_pd (_prev, input);
+	_phase = 1 - _phase;
+}
+
+
+
+/*
+==============================================================================
+Name: process_block
+Description:
+	From a block of 2-channel input vectors, generates two blocks of vectors
+	with a pi/2 phase shift between these signals.
+	Input and output blocks may overlap, see assert() for details.
+Input parameters:
+	- in_ptr: Input array, containing nbr_spl samples.
+	- nbr_spl: Number of input samples to process, > 0
+Output parameters:
+	- out_0_ptr: Output sample array (ahead), capacity: nbr_spl samples.
+	- out_1_ptr: Output sample array (late), capacity: nbr_spl samples.
+Throws: Nothing
+==============================================================================
+*/
+
+template <int NC>
+void	PhaseHalfPi2F64Sse2 <NC>::process_block (double out_0_ptr [], double out_1_ptr [], const double in_ptr [], long nbr_spl) noexcept
+{
+	assert (out_0_ptr != nullptr);
+	assert (out_1_ptr != nullptr);
+	assert (in_ptr    != nullptr);
+	assert (out_0_ptr <= in_ptr || out_0_ptr >= in_ptr + nbr_spl * _nbr_chn);
+	assert (out_1_ptr <= in_ptr || out_1_ptr >= in_ptr + nbr_spl * _nbr_chn);
+	assert (   out_0_ptr + nbr_spl * _nbr_chn <= out_1_ptr
+	        || out_1_ptr + nbr_spl * _nbr_chn <= out_0_ptr);
+	assert (nbr_spl > 0);
+
+	long           pos = 0;
+	if (_phase == 1)
+	{
+		__m128d        out_0;
+		__m128d        out_1;
+		process_sample (out_0, out_1, _mm_loadu_pd (in_ptr));
+		_mm_storeu_pd (out_0_ptr, out_0);
+		_mm_storeu_pd (out_1_ptr, out_1);
+		++ pos;
+	}
+
+	const long     end  = ((nbr_spl - pos) & -_nbr_phases) + pos;
+	__m128d        prev = _mm_load_pd (_prev);
+	while (pos < end)
+	{
+		const auto     ofs_0   = pos * _nbr_chn;
+		const __m128d  input_0 = _mm_loadu_pd (in_ptr + ofs_0);
+		__m128d        out_0   = input_0;
+		__m128d        out_1   = prev;
+		StageProc2F64Sse2 <NBR_COEFS>::process_sample_neg (
+			NBR_COEFS, out_0, out_1, &_bifilter [0] [0]
+		);
+		_mm_storeu_pd (out_0_ptr + ofs_0, out_0);
+		_mm_storeu_pd (out_1_ptr + ofs_0, out_1);
+
+		const auto     ofs_1   = ofs_0 + _nbr_chn;
+		const __m128d  input_1 = _mm_loadu_pd (in_ptr + ofs_1);
+		out_0 = input_1;
+		out_1 = input_0;  // prev
+		StageProc2F64Sse2 <NBR_COEFS>::process_sample_neg (
+			NBR_COEFS, out_0, out_1, &_bifilter [1] [0]
+		);
+		_mm_storeu_pd (out_0_ptr + ofs_1, out_0);
+		_mm_storeu_pd (out_1_ptr + ofs_1, out_1);
+
+		prev = input_1;
+		pos += 2;
+	}
+	_mm_store_pd (_prev, prev);
+
+	if (pos < nbr_spl)
+	{
+		assert (pos + 1 == nbr_spl);
+		__m128d        out_0;
+		__m128d        out_1;
+		const auto     ofs = pos * _nbr_chn;
+		process_sample (out_0, out_1, _mm_loadu_pd (in_ptr + ofs));
+		_mm_storeu_pd (out_0_ptr + ofs, out_0);
+		_mm_storeu_pd (out_1_ptr + ofs, out_1);
+	}
+}
+
+
+
+/*
+==============================================================================
+Name: clear_buffers
+Description:
+	Clears filter memory, as if it processed silence since an infinite amount
+	of time.
+Throws: Nothing
+==============================================================================
+*/
+
+template <int NC>
+void	PhaseHalfPi2F64Sse2 <NC>::clear_buffers () noexcept
+{
+	_phase = 0;
+	for (int i = 0; i < NBR_COEFS + 2; ++i)
+	{
+		_mm_store_pd (_bifilter [0] [i]._mem, _mm_setzero_pd ());
+		_mm_store_pd (_bifilter [1] [i]._mem, _mm_setzero_pd ());
+	}
+	_mm_store_pd (_prev,  _mm_setzero_pd ());
+}
+
+
+
+/*\\\ PROTECTED \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\*/
+
+
+
+/*\\\ PRIVATE \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\*/
+
+
+
+template <int NC>
+constexpr int	PhaseHalfPi2F64Sse2 <NC>::_nbr_phases;
+
+
+
