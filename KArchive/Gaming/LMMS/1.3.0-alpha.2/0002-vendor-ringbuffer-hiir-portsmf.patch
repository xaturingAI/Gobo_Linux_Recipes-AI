+int	round_int (double x)
+{
+	return int (floor (x + 0.5));
+}
+
+
+
+int	ceil_int (double x)
+{
+	return int (ceil (x));
+}
+
+
+
+template <class T>
+T	ipowp (T x, long n) noexcept
+{
+	assert (n >= 0);
+
+	T              z (1);
+	while (n != 0)
+	{
+		if ((n & 1) != 0)
+		{
+			z *= x;
+		}
+		n >>= 1;
+		x *= x;
+	}
+
+	return z;
+}
+
+
