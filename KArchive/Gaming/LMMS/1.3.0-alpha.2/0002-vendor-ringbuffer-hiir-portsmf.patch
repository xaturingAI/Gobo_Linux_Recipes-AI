+// input is time, return value is time
+double Alg_seq::nearest_beat_time(double time, double *beat)
+{
+    double b = time_map->time_to_beat(time);
+    b = time_sig.nearest_beat(b);
+    if (beat) {
+        *beat = b;
+    }
+    return time_map->beat_to_time(b);
+}
