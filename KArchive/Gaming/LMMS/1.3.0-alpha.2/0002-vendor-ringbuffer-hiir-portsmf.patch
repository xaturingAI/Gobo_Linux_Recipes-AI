+bool Alg_event::overlap(double t, double len, bool all)
+{
+    // event starts within region
+    if (time >= t && time <= t + len - ALG_EPS) {
+        return true;
+    }
+    if (all && is_note()) {
+        double dur = ((Alg_note_ptr) this)->dur;
+        // note overlaps with region
+        if (time < t && time + dur - ALG_EPS > t) {
+            return true;
+        }
+    }
+    // does not overlap
+    return false;
+}
