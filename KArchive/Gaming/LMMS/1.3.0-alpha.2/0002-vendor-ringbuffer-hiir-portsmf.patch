diff -ruN --new-file '--exclude=.git' a/plugins/MidiImport/portsmf/src/allegrosmfrd.cpp b/plugins/MidiImport/portsmf/src/allegrosmfrd.cpp
--- a/plugins/MidiImport/portsmf/src/allegrosmfrd.cpp	1969-12-31 19:00:00.000000000 -0500
+++ b/plugins/MidiImport/portsmf/src/allegrosmfrd.cpp	2025-03-27 17:58:49.000000000 -0400
