+
+	const float32x2_t tmp = load2a (stage_ptr [CUR - 1]._mem);
+	storea (stage_ptr [CUR - 1]._mem, x);
+
+	x += load2a (stage_ptr [CUR]._mem );
+	x *= load2a (stage_ptr [CUR]._coef);
+	x -= tmp;
+}
