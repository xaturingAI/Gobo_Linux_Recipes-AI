+	DT & DT::operator = (const DT &);
+	DT & DT::operator += (const DT &);
+	DT & DT::operator -= (const DT &);
+	DT & DT::operator *= (const DT &);
+	DT operator + (DT, const DT &);
+	DT operator - (DT, const DT &);
+	DT operator * (DT, const DT &);
+
+- NCHN: number of contained scalars, if DT is a vector type.
