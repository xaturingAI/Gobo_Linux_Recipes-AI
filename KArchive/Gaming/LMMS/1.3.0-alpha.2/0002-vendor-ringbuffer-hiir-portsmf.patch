+template <int NC>
+void	PhaseHalfPi2F64Sse2 <NC>::set_coefs (const double coef_arr []) noexcept
+{
+	assert (coef_arr != nullptr);
+
+	for (int i = 0; i < NBR_COEFS; ++i)
+	{
+		const __m128d  c = _mm_set1_pd (DataType (coef_arr [i]));
+		_mm_store_pd (_bifilter [0] [i + 2]._coef, c);
+		_mm_store_pd (_bifilter [1] [i + 2]._coef, c);
