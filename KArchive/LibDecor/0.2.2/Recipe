# Custom recipe for LibDecor 0.2.2 (meson)
# Wayland window-decoration library (xdg-decoration global). Gives SDL2/GTK3
# apps under a wlroots compositor proper titlebars. Builds only the built-in
# cairo plugin: the GTK3 plugin is disabled (-Dgtk=disabled) so this can build
# in the wayland phase before the Pantheon/GTK3 tier, and the demo programs are
# dropped (-Ddemo=false). Needs wayland-client + wayland-protocols
# (xdg-shell/xdg-decoration) + cairo.
compile_version=017-GIT
url="https://gitlab.freedesktop.org/libdecor/libdecor/-/releases/0.2.2/downloads/libdecor-0.2.2.tar.xz"
file_size=44988
file_md5=5b7f4a10a9335b62101bccc220e2d13a
dir='libdecor-0.2.2'
recipe_type=meson
meson_variables=(
    -Ddemo=false
    -Dgtk=disabled
)