#!/bin/bash

# NVIDIA userspace utilities + libraries 615.71.09 (Arch-style "nvidia-utils").
#
# Part of the Arch-style split of the NVIDIA stack. This recipe unpacks the SAME
# NVIDIA-Linux-x86_64-615.71.09.run as Recipes/Nvidia/615.71.09 but installs the
# userspace half: the 64-bit libraries, the command-line tools, the Vulkan ICD
# registration, the glvnd EGL vendor registration, the OpenCL ICD, the udev load
# rule, the modprobe blacklist and the Xorg OutputClass.
#
# OWNERSHIP MAP (who ships what in the split):
#   Nvidia                 -> kernel modules, Xorg DDX (nvidia_drv.so +
#                             libglxserver_nvidia.so), nvidia-drm-outputclass.conf,
#                             and (transitionally) nvidia-settings + its .desktop/
#                             icon + the NvidiaCtl task.
#   Nvidia-Utils (here)    -> 64-bit libs, tools, Vulkan/glvnd JSONs, OpenCL ICD,
#                             60-nvidia.rules, nvidia.conf, 10-nvidia.conf,
#                             application profiles, NVNGX/DLSS wine DLLs.
#   Lib32-Nvidia-Utils     -> the 32-bit libs. NOT created yet, so for now the
#                             32-bit set stays HERE (see lib32 block below) to
#                             keep Steam/32-bit games working; it is peeled out
#                             when Lib32-Nvidia-Utils lands.
#   Linux-Firmware-Nvidia  -> NOT created: it would only re-copy the same 4
#                             blobs from this same .run, so the GSP/ucode
#                             firmware stays in the Nvidia recipe.
#   Nvidia-Settings        -> the nvidia-settings GUI.
#
# NOTE on absolute paths: the Vulkan ICD JSONs are rewritten with ABSOLUTE
# library paths into /Programs/Nvidia-Utils/Current/lib{,32} (not just
# libGLX_nvidia.so.0) so Proton's bwrap sandbox loads THIS program's library and
# not a stale one. If the 64-bit libs ever move again, this sed and the matching
# apply-live-fixes blocks must move with them.

compile_version=017-GIT
url="https://download.nvidia.com/XFree86/Linux-x86_64/615.71.09/NVIDIA-Linux-x86_64-615.71.09.run"
file_size=529618784
file_md5=82ed972f937bf7324542a163272b6d11
recipe_type=manifest
uncompress=no
needs_safe_linking=yes

symlink_options=(
    "--conflict=overwrite"
)

# Runtime + registration data that lands in the system root outside /Programs.
unmanaged_files=(
    "usr/share/vulkan/icd.d/nvidia_icd.json"
    "usr/share/vulkan/icd.d/nvidia_icd.x86_64.json"
    "usr/share/vulkan/icd.d/nvidia_icd.i686.json"
    "usr/share/vulkan/icd.d/nvidia_icd_vksc.json"
    "usr/share/vulkan/implicit_layer.d/nvidia_layers.json"
    "usr/share/glvnd/egl_vendor.d/09_nvidia_wayland2.json"
    "usr/share/glvnd/egl_vendor.d/10_nvidia.json"
    "usr/share/glvnd/egl_vendor.d/10_nvidia_wayland.json"
    "usr/share/glvnd/egl_vendor.d/15_nvidia_gbm.json"
    "usr/share/glvnd/egl_vendor.d/20_nvidia_xcb.json"
    "usr/share/glvnd/egl_vendor.d/20_nvidia_xlib.json"
    "usr/share/X11/xorg.conf.d/10-nvidia.conf"
    "usr/share/X11/xorg.conf.d/nvidia-drm-outputclass.conf"
    "usr/share/dbus-1/system.d/nvidia-dbus.conf"
    "usr/share/nvidia/nvidia-application-profiles-615.71.09-rc"
    "usr/share/nvidia/nvidia-application-profiles-615.71.09-key-documentation"
    "etc/udev/rules.d/60-nvidia.rules"
    "etc/modprobe.d/nvidia.conf"
    "etc/OpenCL/vendors/nvidia.icd"
)

pre_install() {
    local archive="$compileArchivesDir/$(basename $url)"
    Log_Normal "Uncompressing NVIDIA installer ${archive}"
    sh "$archive" -x || Die "Failed to uncompress the NVIDIA installer."
    pkgdir=$(basename "$url" | sed 's,\.run$,,g')
    mv "$pkgdir"/* .
    rm -rf "$pkgdir"
}

do_install() {
    # 64-bit libraries: the glvnd stubs the .run ships (libGL.so.1.7.0 etc.) plus
    # libcuda, libcudadebugger and the whole libnvidia-* family.
    mkdir -p "$target"/lib
    cp -a libGL.so.1.7.0 libEGL.so.1.1.0 libEGL.so.615.71.09 libGLESv1_CM.so.1.2.0 \
          libGLESv2.so.2.1.0 libGLX.so.0 libGLdispatch.so.0 libOpenCL.so.1.0.0 \
          libOpenGL.so.0 libGLX_nvidia.so.615.71.09 libEGL_nvidia.so.615.71.09 \
          libGLESv1_CM_nvidia.so.615.71.09 libGLESv2_nvidia.so.615.71.09 \
          libnvidia-*.so.* libcuda.so.* libcudadebugger.so.* libnvcuvid.so.* \
          libvdpau_nvidia.so.* libnvoptix.so.* \
          "$target"/lib/ || Die "Failed copying 64-bit libraries."

    # 32-bit libraries. TRANSITIONAL: these belong to Lib32-Nvidia-Utils once it
    # exists; they stay here so 32-bit Steam/games keep working in the meantime.
    mkdir -p "$target"/lib32
    cp -a 32/*.so* "$target"/lib32/ || Die "Failed copying 32-bit libraries."

    # NVNGX / DLSS Wine DLLs (64-bit PE only; Wine/Proton bridge them to 32-bit).
    mkdir -p "$target"/lib/nvidia/wine
    cp -a _nvngx.dll nvngx.dll "$target"/lib/nvidia/wine/ || Die "Failed copying NVNGX DLLs."
    cp -a nvngx_dlssg.dll "$target"/lib/nvidia/wine/ || Die "Failed copying DLSS-G DLL."

    # Tools. nvidia-settings is deliberately NOT here (Nvidia-Settings recipe).
    mkdir -p "$target"/bin "$target"/sbin
    for tool in nvidia-smi nvidia-xconfig nvidia-modprobe \
                nvidia-debugdump nvidia-persistenced nvidia-powerd \
                nvidia-cuda-mps-control nvidia-cuda-mps-server \
                nvidia-pcc nvidia-ngx-updater
    do [ -x "$tool" ] && cp -a "$tool" "$target"/bin/
    done
    [ -x nvidia-bug-report.sh ] && cp -a nvidia-bug-report.sh "$target"/bin/

    # Man pages.
    mkdir -p "$target"/man/man1
    cp -a *.1.gz "$target"/man/man1/

    # OpenCL ICD.
    mkdir -p "$target"/Resources/Unmanaged/etc/OpenCL/vendors
    cp -a nvidia.icd "$target"/Resources/Unmanaged/etc/OpenCL/vendors/nvidia.icd

    # Shared data (Vulkan/GLVND ICDs, xorg.conf.d, dbus, profiles).
    local share="$target/Resources/Unmanaged/usr/share"
    mkdir -p "$share"/vulkan/icd.d "$share"/vulkan/implicit_layer.d \
             "$share"/glvnd/egl_vendor.d "$share"/X11/xorg.conf.d \
             "$share"/dbus-1/system.d "$share"/nvidia
    cp -a nvidia_icd.json nvidia_icd_vksc.json "$share"/vulkan/icd.d/
    # Arch-split ICD JSONs with absolute paths for Proton bwrap sandbox compat.
    sed 's|"library_path": "libGLX_nvidia.so.0"|"library_path": "/Programs/Nvidia-Utils/Current/lib/libGLX_nvidia.so.0"|' \
        nvidia_icd.json > "$share"/vulkan/icd.d/nvidia_icd.x86_64.json
    sed 's|"library_path": "libGLX_nvidia.so.0"|"library_path": "/Programs/Nvidia-Utils/Current/lib32/libGLX_nvidia.so.0"|' \
        nvidia_icd.json > "$share"/vulkan/icd.d/nvidia_icd.i686.json
    cp -a nvidia_layers.json "$share"/vulkan/implicit_layer.d/
    # glvnd EGL external platforms shipped by the driver itself: egl-wayland
    # (1.1.20), egl-wayland2 (1.0.2), egl-gbm and the egl-x11 xcb/xlib pair.
    # post_install pins the .so.1 sonames in both architectures.
    for f in 09_nvidia_wayland2.json 10_nvidia.json 10_nvidia_wayland.json \
             15_nvidia_gbm.json 20_nvidia_xcb.json 20_nvidia_xlib.json
    do cp -a "$f" "$share"/glvnd/egl_vendor.d/
    done
    cp -a nvidia-drm-outputclass.conf "$share"/X11/xorg.conf.d/
    cp -a nvidia-dbus.conf "$share"/dbus-1/system.d/
    cp -a nvidia-application-profiles-615.71.09-rc \
          nvidia-application-profiles-615.71.09-key-documentation "$share"/nvidia/

    # modprobe options + nouveau blacklist (packaged; the Settings-dir copy in
    # pre_link is only compile-time convenience and is not shipped).
    mkdir -p "$target/Resources/Unmanaged/etc/modprobe.d"
    cat > "$target/Resources/Unmanaged/etc/modprobe.d/nvidia.conf" <<'EOF'
blacklist nouveau
options nvidia-drm modeset=1 fbdev=1
EOF

    # nvidia-settings-friendly Xorg OutputClass (packaged).
    mkdir -p "$target/Resources/Unmanaged/usr/share/X11/xorg.conf.d"
    cat > "$target/Resources/Unmanaged/usr/share/X11/xorg.conf.d/10-nvidia.conf" <<'EOF'
Section "OutputClass"
    Identifier    "nvidia"
    MatchDriver   "nvidia-drm"
    Driver        "nvidia"
    Option        "AllowEmptyInitialConfiguration" "true"
    Option        "NoLogo" "true"
    Option        "ForceFullCompositionPipeline" "true"
    Option        "TripleBuffer" "true"
EndSection
EOF

    # udev rule: /dev/nvidia* permissions + PCI-class rule that auto-loads the
    # whole driver stack at boot when an NVIDIA GPU is present.
    mkdir -p "$target/Resources/Unmanaged/etc/udev/rules.d"
    cat > "$target/Resources/Unmanaged/etc/udev/rules.d/60-nvidia.rules" <<'EOF'
SUBSYSTEM=="pci", ACTION=="add", ATTRS{vendor}=="0x10de", ATTR{class}=="0x030000", TAG+="uaccess", RUN+="/usr/bin/nvidia-modprobe -c 0 -m -u"
SUBSYSTEM=="pci", ACTION=="add", ATTRS{vendor}=="0x10de", ATTR{class}=="0x030200", TAG+="uaccess", RUN+="/usr/bin/nvidia-modprobe -c 0 -m -u"
KERNEL=="nvidia", RUN+="/usr/bin/nvidia-modprobe -c 0"
KERNEL=="nvidia_modeset", RUN+="/usr/bin/nvidia-modprobe -c 0 -m"
KERNEL=="nvidia_uvm", RUN+="/usr/bin/nvidia-modprobe -c 0 -u"
KERNEL=="nvidia_drm", RUN+="/usr/bin/nvidia-modprobe -c 0 -m"
SUBSYSTEM=="nvidia", KERNEL=="card*", RUN+="/usr/bin/nvidia-modprobe -c 0"
EOF
}

post_install() {
    # soname symlinks for the 64-bit and 32-bit libraries.
    private__create_lib_symlinks "$target/lib"
    private__create_lib_symlinks "$target/lib32"
    # glvnd loads the vendor libs by these unversioned names.
    ln -sf libGLX_nvidia.so.615.71.09 "$target/lib/libGLX_nvidia.so.0"
    ln -sf libEGL_nvidia.so.615.71.09 "$target/lib/libEGL_nvidia.so.0"
    ln -sf libGLX_nvidia.so.615.71.09 "$target/lib32/libGLX_nvidia.so.0"
    ln -sf libEGL_nvidia.so.615.71.09 "$target/lib32/libEGL_nvidia.so.0"

    # EGL external platforms, pinned by soname so the packaged glvnd vendor
    # JSONs always resolve to THIS driver's libraries (both architectures):
    #   10_nvidia_wayland.json  -> libnvidia-egl-wayland.so.1   (egl-wayland)
    #   09_nvidia_wayland2.json -> libnvidia-egl-wayland2.so.1  (egl-wayland2)
    #   15_nvidia_gbm.json      -> libnvidia-egl-gbm.so.1
    #   20_nvidia_xcb.json      -> libnvidia-egl-xcb.so.1
    #   20_nvidia_xlib.json     -> libnvidia-egl-xlib.so.1
    local d
    for d in lib lib32; do
        ln -sf libnvidia-egl-wayland.so.1.1.20  "$target/$d/libnvidia-egl-wayland.so.1"
        ln -sf libnvidia-egl-wayland2.so.1.0.2  "$target/$d/libnvidia-egl-wayland2.so.1"
        ln -sf libnvidia-egl-gbm.so.1.1.3       "$target/$d/libnvidia-egl-gbm.so.1"
        ln -sf libnvidia-egl-xcb.so.1.0.6       "$target/$d/libnvidia-egl-xcb.so.1"
        ln -sf libnvidia-egl-xlib.so.1.0.6      "$target/$d/libnvidia-egl-xlib.so.1"
        ln -sf libnvidia-wayland-client.so.615.71.09 "$target/$d/libnvidia-wayland-client.so.1"
    done

    # Register the 32-bit library dir for the dynamic linker. TRANSITIONAL with
    # the lib32 block above; moves to Lib32-Nvidia-Utils.
    local confd="$target/Resources/Defaults/Settings/ld.so.conf.d"
    mkdir -p "$confd"
    echo "$target/lib32" > "$confd/nvidia-32.conf"
}

private__create_lib_symlinks() {
    local dir="$1"
    [ -d "$dir" ] || return 0
    cd "$dir" || return 0
    for f in lib*.so* libnvidia-*.so* libcuda.so* libvdpau_nvidia.so* libnvoptix.so*
    do
        [ -f "$f" ] || continue
        local soname=$(readelf -d "$f" 2>/dev/null | awk -F'[' '/SONAME/{gsub(/]/,"",$2); print $2}')
        [ -n "$soname" ] && [ "$soname" != "$f" ] && ln -sf "$f" "$soname"
    done
}

post_install_message="
NVIDIA userspace (nvidia-utils) 615.71.09 installed to /Programs/Nvidia-Utils.
- Tools:    nvidia-smi, nvidia-xconfig, nvidia-modprobe, nvidia-persistenced,
            nvidia-powerd, nvidia-debugdump, nvidia-cuda-mps-*, nvidia-pcc,
            nvidia-ngx-updater, nvidia-bug-report.sh
- 64-bit libraries in lib/ (89 files) and 32-bit in lib32/ (61 files).
- Vulkan ICDs (nvidia_icd.json + the absolute-path x86_64/i686 variants) are
  registered in /usr/share/vulkan/icd.d/ via unmanaged_files; the loader finds
  them through /System/Index/share/vulkan.
- glvnd EGL external platforms (egl-wayland 1.1.20, egl-wayland2 1.0.2, egl-gbm,
  egl-x11 xcb/xlib) registered in /usr/share/glvnd/egl_vendor.d/, sonames pinned.
- Kernel modules and the Xorg DDX come from the Nvidia recipe, which also
  ships the GSP/ucode firmware (/lib/firmware/nvidia/615.71.09/).
"
