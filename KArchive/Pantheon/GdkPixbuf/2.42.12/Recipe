# Custom recipe for GdkPixbuf 2.42.12 (GNOME 48 era; meson)
#
# Part of the Pantheon stack port. Bumped from the ISO's 2.42.x. Needs GLib
# >= 2.84 installed first. The ISO already ships libpng and libjpeg-turbo,
# so the loaders will be linked automatically.
#
# Era: GNOME 48 (Mar 2025). file_md5 placeholder -- verify after download.

compile_version=017-GIT
url="https://download.gnome.org/sources/gdk-pixbuf/2.42/gdk-pixbuf-2.42.12.tar.xz"
file_size=6525072
file_md5=f986fdbba5ec6233c96f8b6535811780
dir='gdk-pixbuf-2.42.12'
recipe_type=meson

# - docs/gtk_doc/man: not shipped on the ISO.
# - introspection OFF until the full gobject-introspection recipe chain
#   lands.
# - Default loaders (png/jpeg/tiff/gif) are sufficient.
meson_variables=(
    --buildtype=release
    "-Dgtk_doc=false"
    "-Dintrospection=disabled"
    "-Dman=false"
    "-Dtests=false"
    "-Dinstalled_tests=false"
    "-Ddefault_library=shared"
)