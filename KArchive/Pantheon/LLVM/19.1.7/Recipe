# Custom recipe for LLVM 19.1.7 + clang (cmake)
#
# Part of the Pantheon desktop stack port. Mesa 25.3.6 needs LLVM >= 18 for
# the radeonsi/llvmpipe drivers (llvmpipe is the software fallback for the
# LiveCD desktop). Built from the llvm-project release tag.
#
# clang IS built now (LLVM_ENABLE_PROJECTS=clang). Mesa 25.3.6 lists the iris
# (Intel) gallium driver in `with_driver_using_cl`, so with_clc=true and Mesa's
# CLC machinery hard-requires dep_clang (clang-cpp / clangBasic..clangAnalysis
# in LLVM_LIBRARY_DIR) plus clang's OpenCL resource headers
# (lib/clang/19/include/opencl-c.h). Keeping clang in the SAME program tree as
# LLVM makes both resolve under /Programs/LLVM/19.1.7 (Mesa reads
# LLVM_LIBRARY_DIR and appends /clang/19/include). Without iris the Intel iGPU
# falls back to llvmpipe/software rendering and the SDDM greeter comes up
# glitched or black on real Intel laptops.
# -DCLANG_LINK_CLANG_DYLIB=ON produces libclang-cpp.so, the single library
# Meson's cpp.find_library('clang-cpp') looks for.
#
# Build AFTER the GCC 14 toolchain (built in an earlier step). llvm-config
# is installed into the index bin so Mesa's meson config-tool dependency
# finds it.
#
# Shared dylib build (-DLLVM_BUILD_LLVM_DYLIB=ON) so Mesa links libLLVM.so
# dynamically instead of a huge static link; X86 + AMDGPU targets cover
# llvmpipe (JIT) and radeonsi (AMD shader backend). Docs/tests/bindings and
# optional libs (terminfo/zlib/zstd/libxml2/ffi) are all disabled.

compile_version=017-GIT
url="https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-19.1.7.tar.gz"
file="llvm-19.1.7.tar.gz"
file_size=217422846
file_md5=48b47ec165a22bd11e400259f96706a6
dir='llvm-project-llvmorg-19.1.7/llvm'
recipe_type=cmake

cmake_options=(
    -DCMAKE_BUILD_TYPE=Release
    -DLLVM_ENABLE_PROJECTS=clang
    -DCLANG_LINK_CLANG_DYLIB=ON
    "-DLLVM_TARGETS_TO_BUILD=X86;AMDGPU"
    -DLLVM_INCLUDE_TESTS=OFF
    -DLLVM_INCLUDE_EXAMPLES=OFF
    -DLLVM_INCLUDE_BENCHMARKS=OFF
    -DLLVM_INCLUDE_DOCS=OFF
    -DCLANG_INCLUDE_TESTS=OFF
    -DCLANG_INCLUDE_DOCS=OFF
    -DLLVM_ENABLE_TERMINFO=OFF
    -DLLVM_ENABLE_ZLIB=OFF
    -DLLVM_ENABLE_ZSTD=OFF
    -DLLVM_ENABLE_LIBXML2=OFF
    -DLLVM_ENABLE_FFI=OFF
    -DLLVM_ENABLE_BINDINGS=OFF
    -DLLVM_BUILD_LLVM_DYLIB=ON
    -DLLVM_LINK_LLVM_DYLIB=ON
)
