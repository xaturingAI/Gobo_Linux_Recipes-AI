# Custom recipe for ksystemstats 6.7.4 (cmake, Plasma)
# Companion daemon that feeds KSysGuard-based monitors (systemmonitor etc.)
# live CPU/RAM/net/disk/sensor data via Plasma::DataEngine. Links against the
# libksysguard library -> needs KSysGuardConfig >= 6.7.0, so it must build
# after KDE/KSysGuard in step_plasma.
#
# REQUIRED (CMakeLists.txt): Qt6 Core+Test, KF6 CoreAddons/Solid/KIO/Crash,
# KF6NetworkManagerQt (CONFIG REQUIRED on LINUX; NetworkManager-Qt 6.26.0 is
# already built) + KSysGuardConfig (KSysGuard 6.7.4). Sensors (LM-Sensors 3.6.0
# in-tree) and NL/UDev/Libcap/Devinfo are all *optional* finds, so nothing else
# is needed. Build tests off (Qt6Test only used for the test-suite target).
compile_version=017-GIT
url="https://download.kde.org/stable/plasma/6.7.4/ksystemstats-6.7.4.tar.xz"
file_size=165032
file_md5=cc47c85067e1db3b084c94e07e650398
dir='ksystemstats-6.7.4'
recipe_type=cmake
cmake_options=(
    -DBUILD_WITH_QT6=ON
    -DCMAKE_BUILD_TYPE=Release
    "-DCMAKE_PREFIX_PATH=/Programs/QtBase/6.10.3;/Programs/QtShaderTools/6.10.3;/Programs/QtDeclarative/6.10.3;/Programs/Qt5Compat/6.10.3;/Programs/QtSVG/6.10.3;/Programs/QtWayland/6.10.3;/Programs/QtTools/6.10.3;/Programs/Qtimageformats/6.10.3;/System/Index"
    "-DQT_ADDITIONAL_PACKAGES_PREFIX_PATH=/Programs/QtShaderTools/6.10.3;/Programs/QtDeclarative/6.10.3;/Programs/Qt5Compat/6.10.3;/Programs/QtSVG/6.10.3;/Programs/QtWayland/6.10.3;/Programs/QtTools/6.10.3;/Programs/Qtimageformats/6.10.3;/Programs/QtMultimedia/6.10.3"
    -DCMAKE_INSTALL_LIBDIR=lib
    -DBUILD_TESTING=OFF
)