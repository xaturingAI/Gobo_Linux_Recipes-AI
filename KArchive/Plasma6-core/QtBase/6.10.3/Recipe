# Custom recipe for qtbase 6.10.3 (cmake)
# Qt 6 module. Installs to /Programs/Qt6/6.10.3 (NOT /Programs/Qt).
# The Qt5 SDDM/greeter closure must remain intact.
compile_version=017-GIT
url="https://download.qt.io/official_releases/qt/6.10/6.10.3/submodules/qtbase-everywhere-src-6.10.3.tar.xz"
file_size=50509856
file_md5=53f04564a696246c3e115028affb6bea
dir='qtbase-everywhere-src-6.10.3'
recipe_type=cmake
cmake_options=(
    -DBUILD_WITH_QT6=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/Programs/Qt6/6.10.3
    -DCMAKE_PREFIX_PATH=/System/Index
    -DCMAKE_INSTALL_LIBDIR=lib
    -DBUILD_TESTING=OFF
    -DBUILD_HTML_DOCS=OFF
    -DBUILD_MAN_DOCS=OFF
    -DFEATURE_system_xcb=ON
    -DFEATURE_wayland=ON
    -DFEATURE_icu=ON
    -DFEATURE_reduce_relocations=OFF
)
