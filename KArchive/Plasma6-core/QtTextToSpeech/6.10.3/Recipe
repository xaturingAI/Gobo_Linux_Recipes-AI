# Custom recipe for qtspeech 6.10.3 (cmake)
# Qt 6 module. Installs to /Programs/Qt6/6.10.3 (NOT /Programs/Qt).
# The Qt5 SDDM/greeter closure must remain intact.
# KF6 requires Qt6TextToSpeech (KTextWidgets/KTextEditor find_package REQUIRED).
# No flite/speech-dispatcher on the ISO -> engine backends disabled explicitly;
# the framework/API lib still builds and exports Qt6TextToSpeech (mock plugin only).
# Note: links Qt::Multimedia and optionally Qt::Qml, hence both in the prefix path.
compile_version=017-GIT
url="https://download.qt.io/official_releases/qt/6.10/6.10.3/submodules/qtspeech-everywhere-src-6.10.3.tar.xz"
file_size=248140
file_md5=2aa0adf1f4b83efac392f888ae028696
dir='qtspeech-everywhere-src-6.10.3'
recipe_type=cmake
cmake_options=(
    -DBUILD_WITH_QT6=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/Programs/Qt6/6.10.3
    "-DCMAKE_PREFIX_PATH=/Programs/QtBase/6.10.3;/Programs/QtShaderTools/6.10.3;/Programs/QtDeclarative/6.10.3;/Programs/Qt5Compat/6.10.3;/Programs/QtSVG/6.10.3;/Programs/QtWayland/6.10.3;/Programs/QtTools/6.10.3;/Programs/Qtimageformats/6.10.3;/System/Index"
    "-DQT_ADDITIONAL_PACKAGES_PREFIX_PATH=/Programs/QtShaderTools/6.10.3;/Programs/QtDeclarative/6.10.3;/Programs/Qt5Compat/6.10.3;/Programs/QtSVG/6.10.3;/Programs/QtWayland/6.10.3;/Programs/QtTools/6.10.3;/Programs/Qtimageformats/6.10.3;/Programs/QtMultimedia/6.10.3"
    -DCMAKE_INSTALL_LIBDIR=lib
    -DBUILD_TESTING=OFF
    -DFEATURE_system_xcb=ON
    -DFEATURE_wayland=ON
    -DFEATURE_icu=ON
    -DFEATURE_reduce_relocations=OFF
    -DFEATURE_flite=OFF
    -DFEATURE_speechd=OFF
)