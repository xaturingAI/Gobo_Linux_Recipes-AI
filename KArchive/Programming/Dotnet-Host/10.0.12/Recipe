#!/bin/bash

# .NET Host 10.0.12 -- muxer + hostfxr only (Arch/AUR dotnet-host split).
#
# WHY: dotnet-host is one of the Arch/AUR split package names (it owns the
# muxer and /usr/bin/dotnet there). On this ISO the full SDKs already provide
# the muxer, so this recipe exists so the NAME resolves; it deliberately does
# NOT claim /System/Index/bin/dotnet (without shared/ a lone host is not a
# usable default and should not shadow the SDK-provided command).
#
# INSTALL: only the muxer + host + hostfxr from the runtime tarball; no shared/
# runtimes and no SDK. Nothing usable standalone -- purely the component name.
#
# CHECKSUM: Microsoft publishes only SHA-512 (FetchArchive supports md5/sha256),
# so file_size is pinned (CDN Content-Length) with the official SHA-512 recorded
# here for manual verification:
#   sha512 = 58388fdde4f13bd703c7a6f7defb3300b17e42ba5fe8bca50066f80f64ac7406
#            620dcdfb4acc1eff7992750c8cc5cff8369dd12d09730c8a9e8760d6032f7f6e

compile_version=017-GIT
url="https://builds.dotnet.microsoft.com/dotnet/Runtime/10.0.12/dotnet-runtime-10.0.12-linux-x64.tar.gz"
file_size=36638192
recipe_type=manifest
uncompress=no

symlink_options=(
    "--conflict=overwrite"
)

manifest=(
    "dotnet:dotnet"
    "host:host"
)

pre_install() {
    local tarball="$compileArchivesDir/$(basename $url)"
    Log_Normal "Extracting ${tarball}"
    tar xzf "$tarball" || Die "cannot unpack the runtime tarball"
}

post_install() {
    if [ -f LICENSE.txt ] || [ -f ThirdPartyNotices.txt ]
    then
        mkdir -p "$target/share/licenses/dotnet-host"
        cp -a LICENSE.txt ThirdPartyNotices.txt "$target/share/licenses/dotnet-host/" 2>/dev/null
    fi
}