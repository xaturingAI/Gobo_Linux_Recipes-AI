#!/bin/bash

# PyQt5 5.15.11 for GoboLinux -- restores the installer's Qt GUI frontend.
#
# Why this package exists:
#   The base ISO shipped a pip-installed PyQt5 under
#   /System/Aliens/PIP/3.8/lib/python3.8/site-packages/PyQt5. Two things broke
#   it on this CD, so `GoboLinuxInstaller` silently fell back to the TUI:
#
#   1. Python version lock. PyQt5's extension modules are abi3 (portable), but
#      the sip runtime shipped as sip.cpython-38-x86_64-linux-gnu.so, i.e.
#      built for CPython 3.8 ONLY. This CD's /usr/bin/python3 is Python
#      3.11.12 (the 3.8.1 -> 3.11.12 switch), so "from PyQt5 import ..." dies
#      with ModuleNotFoundError: No module named 'PyQt5.sip'. The bare
#      `except: mode = 'curses'` in GoboLinuxInstaller hid this.
#   2. Path exposure. The PIP tree is not on the live session's sys.path at
#      all, so it was unreachable even from a matching interpreter.
#
# This recipe installs the bindings as a proper Gobo program under
#   /Programs/PyQt5/5.15.11/lib/python3.11/site-packages
#
# It deliberately writes NO .pth of its own. Python 3.11 scans exactly one
# global site-packages dir -- its own, /Programs/Python/3.11.12/lib/python3.11/
# site-packages -- and reads .pth only from there. The conventional-looking
# /System/Index/lib/python3.11/site-packages (equivalently /usr/lib/python3.11/
# site-packages) is a symlink farm that Python never scans, so a .pth placed
# there is inert. Wiring this program's directory onto sys.path means writing
# into the Python program's tree, which is a cross-program dependency Compile
# cannot express, so the ISO build does it in a livefix (zfs48.sh) instead.
#
# Why wheels, not a source build:
#   Building PyQt5 from source needs sip + a Qt5 mkspec + ~1h and yields the
#   same abi3 modules. The upstream manylinux wheel is built against Qt 5.15.x
#   with a stable ABI, so it is the better artifact here. sip itself is NOT
#   abi3 -- it is compiled per CPython version -- so the cp311 sip wheel is
#   installed alongside. If the CD's Python is bumped past 3.11, the sip
#   wheel's cp3XX tag must be bumped too (the PyQt5 wheel itself need not be).
#
# Qt libraries: deliberately does NOT install the PyQt5-Qt5 wheel (60 MB of
#   bundled Qt 5.15.19). The CD already ships Qt 5.15.2 under /Programs/Qt, and
#   every libQt5* the bindings NEEDED resolves through /System/Index/lib (which
#   is in ld.so.conf and symlinks to 5.15.2). Verified: 0 missing libs across
#   all PyQt5 modules. Installing the bundled Qt too would put a second,
#   private Qt5 on the ISO and risk mixing it with the Plasma/Qt5 apps that
#   link the system one.
compile_version=017-GIT

# Two archives: the abi3 bindings, then the per-interpreter sip runtime.
# PyQt5 5.15.11 is cp38-abi3 and therefore serves Python 3.8 through 3.13+.
urls=(
   "https://files.pythonhosted.org/packages/b4/8c/4065950f9d013c4b2e588fe33cf04e564c2322842d84dbcbce5ba1dc28b0/PyQt5-5.15.11-cp38-abi3-manylinux_2_17_x86_64.whl"
   "https://files.pythonhosted.org/packages/37/10/14d06676c8d4a31a6e1b6270ff64c2900bfe000d59cd3302a4091f0d11ee/pyqt5_sip-12.19.0-cp311-cp311-manylinux_2_5_x86_64.manylinux1_x86_64.whl"
)
file_sizes=(
   8188103
   276024
)
file_md5s=(
   7265e540dc1cf21ad564286cc293a021
   9c6a3496ba9561c396f7bcf8916f114b
)

# A wheel is a zip, but there is nothing to unpack or patch: pip installs
# straight from the archive. uncompress=no makes Compile stage both wheels
# verbatim into $sourcedir (which then does exist, so Compile's "Directory
# $sourcedir not found" guard is happy) and default to unpack_files=files_in_root
# so the two differently-named wheels coexist in one directory.
uncompress=no

# recipe_type=python is still the right base even though pip does the real
# work: it sets create_dirs_first (so $target exists before the hook runs),
# runs python_sane_check up front, and provides do_build/do_install bodies we
# disable. Wheels carry no setup.py, so pre_install drives pip instead.
recipe_type=python
python_major=3.11
do_build=no
do_install=no

# Compile runs each hook in a SEPARATE generated script (./pre_install.sh) that
# sources only ScriptFunctions, GoboLinux, OptionParser, Log, Compile.conf and
# this recipe, and exports only the variables passed to mark_export. That set
# includes target and sourcedir but NOT $python/$sitepackages (set_python_vars
# never marks them) and does NOT define wrap_fail. So inside pre_install:
#   - python3.11 and $target/lib/python3.11/site-packages are spelled out,
#     exactly as the Protontricks and Lutris recipes already do,
#   - failures go through Exit_With (from Import Log), not wrap_fail.
pre_install() {
    local py=python3.11
    local sp="$target/lib/python3.11/site-packages"

    # Verify BOTH wheels by MD5 ourselves. Compile 017-GIT's FetchArchive does
    #     file_sums=${file_md5s}      # array -> scalar: keeps element 0 only
    #     ... Verify_Files "$file" "${file_sizes[url_index]}" "${file_sums[url_index]}"
    # so for a multi-URL recipe every archive after the first is checked on SIZE
    # ONLY and logs "Warning: no MD5/SHA checksum." Verify_Files itself is
    # fine (it takes "${file_md5s[*]}" and re-splits), so this is a one-line
    # bug in FetchArchive, not in our recipe. Until Compile is patched, do the
    # checksum check here where every array index is still intact. Get_MD5 comes
    # from ScriptFunctions/File, which the hook script does source.
    local i got
    for i in "${!urls[@]}"
    do
        local want="${file_md5s[$i]}"
        [ -n "$want" ] || continue
        local f="$sourcedir/$(basename "${urls[$i]}")"
        [ -f "$f" ] || Exit_With 1 "Staged wheel missing: $f"
        got="$(Get_MD5 "$f")"
        [ "$got" = "$want" ] \
            || Exit_With 1 "MD5 mismatch for $(basename "$f"): got $got, want $want"
        Log_Verbose "MD5 OK: $(basename "$f")"
    done

    mkdir -p "$sp" || Exit_With 1 "Cannot create $sp"

    # BOTH wheels must go to pip in ONE invocation. Installing them one after
    # another with a shared --target makes the second call uninstall the first:
    # pip treats the shared PyQt5/ directory as the property of whichever
    # distribution claimed it last, so installing pyqt5-sip deletes the 76
    # bindings files and leaves only sip.cpython-311-*.so behind. A single call
    # resolves the whole set at once and keeps both.
    #
    # --no-deps on purpose: this skips PyQt5-Qt5 (see header) and lets us own
    # the PyQt5/sip pairing rather than let pip resolve it.
    local wheels=()
    local wheel
    for wheel in "$sourcedir"/*.whl
    do
        [ -f "$wheel" ] || continue
        wheels+=("$wheel")
    done
    [ "${#wheels[@]}" -eq 2 ] \
        || Exit_With 1 "Expected 2 wheels in $sourcedir, found ${#wheels[@]}"

    Log_Normal "Installing ${#wheels[@]} wheels into $sp"
    $py -m pip install --no-deps --no-compile --upgrade \
        --target "$sp" "${wheels[@]}" \
        || Exit_With 1 "pip install failed for: ${wheels[*]}"

    [ -e "$sp/PyQt5/QtCore.abi3.so" ] \
        || Exit_With 1 "PyQt5/QtCore.abi3.so missing after install"
    [ -e "$sp/PyQt5/sip.cpython-311-x86_64-linux-gnu.so" ] \
        || Exit_With 1 "cp311 sip runtime missing after install"

    # Fail loudly here rather than letting the installer's bare `except` turn
    # a broken install into a silent TUI downgrade.
    PYTHONPATH="$sp${PYTHONPATH:+:$PYTHONPATH}" $py -c \
        'from PyQt5 import QtCore, QtGui, QtWidgets; print("PyQt5 OK", QtCore.PYQT_VERSION_STR, "on Qt", QtCore.QT_VERSION_STR)' \
        || Exit_With 1 "PyQt5 import verification failed (are the Qt 5 libs reachable via /System/Index/lib?)"
}