#!/bin/bash

# html5lib 1.1 for GoboLinux -- pure-python HTML5 parser.
#
# WHY: QtWebEngine's configure runs
#     ${Python3_EXECUTABLE} -c "import html5lib"
# and hard-gates the whole module on it (configure.cmake:361,
# "python3-html5lib"), so without this package the build stops with
#     "Python3 html5lib is missing (/System/Index/bin/python3.11)."
# Chromium's HTML tokenizer generator also imports it during the build.
#
# BUNDLED DEPENDENCIES: html5lib 1.1 is pure python, but it is NOT
# self-contained. A plain `import html5lib` pulls in:
#     six         -- html5lib/__init__.py, _tokenizer.py, treewalkers, ...
#     webencodings -- html5lib/_inputstream.py:10 (encoding lookup)
# The ISO has neither, so we vendor all three sdists in this one recipe rather
# than adding three near-empty packages and three more build steps. They are
# installed into the same site-packages directory and are independently useful.
#
# Versions: html5lib 1.1 (2016) is the latest release and is what Debian/Fedora
# and Chromium's own requirements resolve to; it is pure python 2/3 compatible.
#
# INSTALL: we pip-install each sdist with --no-deps into
# /System/Index/lib/python3.11/site-packages (the $target Gobo hands us), so the
# dist-info/egg-info metadata is generated by pip itself and `pip3 list` on the CD
# stays truthful. --no-deps is safe precisely because we ship the deps ourselves.
# --no-compile skips .pyc writing; the ISO is built once and shipped as-is.
#
# file_md5 + file_size verified against the PyPI JSON API sdists.

# INSTALL: a plain file copy into /System/Index/lib/python3.11/site-packages
# AND into our own $target tree (see post_install for why both are needed).
#
# We deliberately do NOT use `pip install`. These sdists are legacy-style:
# html5lib 1.1 (2016), six 1.17.0 and webencodings 0.5.1 predate the modern
# pyproject/setuptools build-backend world. pip has to spin up an isolated build
# environment, and if the ISO's interpreter has no setuptools available for it
# the install dies with "BackendUnavailable: Cannot import 'setuptools.build_meta'"
# -- which is exactly what happens on a stock 3.12 venv. Copying three pure
# python trees needs no build backend, no wheel, and no network at install time.
#
# We also ship the sdists' own *.egg-info alongside the packages so the versions
# remain discoverable (pip/importlib.metadata both read egg-info).

compile_version=017-GIT
urls=(
    "https://files.pythonhosted.org/packages/source/h/html5lib/html5lib-1.1.tar.gz"
    "https://files.pythonhosted.org/packages/source/s/six/six-1.17.0.tar.gz"
    "https://files.pythonhosted.org/packages/source/w/webencodings/webencodings-0.5.1.tar.gz"
)
files=(
    "html5lib-1.1.tar.gz"
    "six-1.17.0.tar.gz"
    "webencodings-0.5.1.tar.gz"
)
file_sizes=(
    272215
    34031
    9721
)
file_md5s=(
    6748742e2ec4cb99287a6bc82bcfe2b0
    a0387fe15662c71057b4fb2b7aa9056a
    32f6e261d52e57bf7e1c4d41546d15b8
)
dir='html5lib-1.1'
recipe_type=manifest
uncompress=no

# Unpack the three sdists ourselves; Gobo would otherwise only unpack `dir`.
pre_install() {
    local w="$PWD"
    for t in html5lib-1.1 six-1.17.0 webencodings-0.5.1; do
        Log_Normal "Unpacking $t ..."
        tar xzf "$compileArchivesDir/$t.tar.gz" -C "$w" || Die "cannot unpack $t"
    done
}

post_install() {
    # The interpreter that QtWebEngine's configure actually probes. Resolve it
    # from the ISO rather than hardcoding a path, but fall back to the 3.11 that
    # the log named.
    local py
    py="$(ls -d /System/Index/bin/python3.1? 2>/dev/null | sort -V | tail -1)"
    [ -n "$py" ] || py=/System/Index/bin/python3.11
    [ -x "$py" ] || Die "no python3 interpreter in /System/Index/bin"

    # TWO destinations, both required (this is what Recipes/Gaming/Lutris does):
    #
    #  * /System/Index/lib/python3.11/site-packages -- this is the chroot
    #    python3.11's real sys.path entry, and it is where every other recipe
    #    on this ISO puts added modules (bs4, certifi, cffi, curl_cffi, ...:
    #    89 entries there vs 13 in the Python program's own tree). /usr/lib is a
    #    symlink to ../System/Index/lib, so writing here covers both aliases.
    #    Without this, `import html5lib` fails and QtWebEngine's configure
    #    aborts -- installing only into $target puts the modules in
    #    /Programs/HTML5Lib/1.1/lib/..., which is NOT on sys.path.
    #
    #  * $target/lib/python3.11/site-packages -- our own package tree, so the
    #    files are carried by the HTML5Lib tarball and end up on the ISO. The
    #    Python program's own site-packages is already packaged, so a .pth
    #    dropped there now would be lost when the ISO is assembled; copying the
    #    modules into our own tarball is what actually ships them.
    local syssite="/System/Index/lib/python3.11/site-packages"
    local ownsite="$target/lib/python3.11/site-packages"
    mkdir -p "$syssite" || Die "cannot create $syssite"
    mkdir -p "$ownsite" || Die "cannot create $ownsite"

    # Sweep any stale copy first so a re-run cannot merge two versions.
    rm -rf "$syssite/html5lib" "$syssite/html5lib.egg-info" \
           "$syssite/six.py" "$syssite/webencodings" \
           "$syssite/webencodings.egg-info"

    # six is a single top-level module, not a package.
    [ -f "$PWD/six-1.17.0/six.py" ] || Die "six.py missing from the six sdist"

    # webencodings and html5lib are packages; ship their egg-info too.
    for p in webencodings-0.5.1/webencodings:webencodings \
             html5lib-1.1/html5lib:html5lib ; do
        [ -d "$PWD/${p%%:*}" ] || Die "${p%%:*} missing from its sdist"
    done

    local dest
    for dest in "$syssite" "$ownsite"; do
        cp -a "$PWD/six-1.17.0/six.py" "$dest/six.py" || Die "cannot install six.py into $dest"
        cp -a "$PWD/webencodings-0.5.1/webencodings" "$dest/webencodings" || Die "cannot install webencodings into $dest"
        cp -a "$PWD/html5lib-1.1/html5lib" "$dest/html5lib" || Die "cannot install html5lib into $dest"
        cp -a "$PWD/webencodings-0.5.1/webencodings.egg-info" "$dest/" 2>/dev/null
        cp -a "$PWD/html5lib-1.1/html5lib.egg-info" "$dest/" 2>/dev/null
    done

    # Verify exactly what QtWebEngine's configure check will run, from the same
    # interpreter and with NO PYTHONPATH help, so we prove the modules really are
    # on the system path rather than merely present somewhere. -c 'import
    # html5lib' only proves html5lib imports; parse a document too, which
    # exercises six and webencodings for real.
    Log_Normal "Verifying 'import html5lib' ..."
    "$py" -c 'import html5lib, sys
d = html5lib.parse("<p>hello</p>", namespaceHTMLElements=False)
assert d is not None, "html5lib.parse returned None"
print("html5lib %s OK on %s (sys.path site-packages: %s)" % (
    html5lib.__version__, sys.version.split()[0],
    [p for p in sys.path if "site-packages" in p]))' \
        || Die "html5lib is installed but not importable/usable"
}