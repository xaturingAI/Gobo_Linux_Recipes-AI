# Custom recipe for SwayLock 1.8.6 (meson)
# Sway's screen locker (the $mod+Escape binding in the default sway config).
# Uses the ext-session-lock-v1 protocol from wayland-protocols' staging tree.
# Needs wayland + xkbcommon + cairo + PAM (+ gdk-pixbuf for images, scdoc for
# the man page). -Dwerror=false so it builds cleanly under GCC 14.
compile_version=017-GIT
url="https://github.com/swaywm/swaylock/releases/download/v1.8.6/swaylock-1.8.6.tar.gz"
file_size=34602
file_md5=4595e14743d690afef64dfc7cb75e450
dir='swaylock-1.8.6'
recipe_type=meson
meson_variables=(
    -Dwerror=false
    -Dpam=enabled
    -Dgdk-pixbuf=enabled
    -Dman-pages=enabled
)