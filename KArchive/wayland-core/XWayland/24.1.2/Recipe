# Custom recipe for XWayland 24.1.2 (meson)
# Runs X11 apps under Wayland. -Dglamor=true needs libdrm + epoxy (ISO has
# both); needs Wayland + Wayland-Protocols, LibXcvt, LibXKBfile, and the
# xkbcomp binary at runtime. Install order: after Wayland stack + LibXcvt +
# LibXKBfile, BEFORE Wlroots (wlroots only enables xwayland if it finds the
# 'Xwayland' binary at its own build time).
# Based on the upstream gobo-recipes recipe, adapted to 'meson_variables'.
compile_version=017-GIT
url="https://x.org/archive/individual/xserver/xwayland-24.1.2.tar.xz"
file_size=1302068
file_md5=312c5cf17d1b147df1b787fd170958e1
dir='xwayland-24.1.2'
recipe_type=meson
meson_variables=(
    -Ddri3=true
    -Dglamor=true
)
