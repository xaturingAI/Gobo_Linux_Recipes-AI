# Custom recipe for LibSeccomp 2.6.1 (autotools)
#
# Part of the Pantheon stack port. Seccomp syscall-filter library. gnome-desktop
# 44.5's meson.build does dependency('libseccomp') unconditionally on Linux (no
# disable option; used by its sandbox helper), so libseccomp.pc must be on the
# index before Gnome-Desktop.
#
# Build BEFORE Gnome-Desktop. Autotools with prebuilt configure.
#
# file_md5 verified against the v2.6.1 release tarball.

compile_version=017-GIT
