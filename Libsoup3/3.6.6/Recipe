# Custom recipe for Libsoup3 3.6.6 (GNOME 48 era; meson)
#
# Part of the Pantheon stack port. Provides libsoup-3.0.pc, the modern
# HTTP/SOAP library required by geocode-glib 3.26.4, geoclue 2.8.1 and
# libgweather 4.6.0 (all GNOME-48-era; the ISO only ships the ancient
# libsoup-2.4).
#
# Needs libnghttp2 (HTTP/2) and libpsl; the ISO has libpsl but no nghttp2,
# so LibNghttp2 must be built first. glib-networking supplies TLS at runtime.
#
# Build AFTER LibNghttp2 and BEFORE GeocodeGlib/Geoclue/Libgweather4.
#
# Era: GNOME 48 (Sep 2025). file_md5 verified against download.gnome.org.

compile_version=017-GIT
url="https://download.gnome.org/sources/libsoup/3.6/libsoup-3.6.6.tar.xz"
file_size=1572004
file_md5=9e07742595800ecf301eafb52300dd89
dir='libsoup-3.6.6'
recipe_type=meson

meson_variables=(
    --buildtype=release
    -Dgssapi=disabled
    -Dntlm=disabled
    -Dbrotli=disabled
    -Dtls_check=false
    -Dintrospection=enabled
    -Dvapi=disabled
    -Ddocs=disabled
    -Ddoc_tests=false
    -Dtests=false
    -Dinstalled_tests=false
    -Dsysprof=disabled
    -Dfuzzing=disabled
    -Dpkcs11_tests=disabled
    -Dautobahn=disabled
)
