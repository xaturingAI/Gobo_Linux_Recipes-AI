# Custom recipe for PantheonPolkitAgent 8.1.0 (elementary OS 8 era; meson)
#
# Part of the Pantheon desktop stack port. Source: https://github.com/elementary/pantheon-agent-polkit/archive/refs/tags/8.1.0.tar.gz

compile_version=017-GIT
url="https://github.com/elementary/pantheon-agent-polkit/archive/refs/tags/8.1.0.tar.gz"
file_size=99902
file_md5=fb36c9f25e5bc8adab33b46c5ac7a70d
dir='pantheon-agent-polkit-8.1.0'
recipe_type=meson

meson_variables=(
    --buildtype=release
    # GoboLinux runs sysvinit + elogind, no systemd: skip the user unit;
    # data/meson.build only does dependency('systemd') when this != 'no'.
    # The agent still autostarts via its installed .desktop file.
    -Dsystemduserunitdir=no
)
